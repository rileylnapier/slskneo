{
  "name": "slskneo",
  "productName": "Soulseek Studio",
  "version": "0.1.0",
  "private": true,
  "description": "A focused Soulseek desktop client with shared MCP control",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/test-electron.cjs",
    "package": "npm run build && node scripts/package.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "@electron/packager": "20.3.0",
    "vite": "8.3.5",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.58.0"
  }
}
